@model DemoMVC.Models.GradeModel

<h2>Tính điểm tổng kết</h2>

<form method="post">
    <label>Điểm A:</label>
    <input type="text" name="DiemA" required /><br/>

    <label>Điểm B:</label>
    <input type="text" name="DiemB" required /><br/>

    <label>Điểm C:</label>
    <input type="text" name="DiemC" required /><br/>

    <button type="submit">Tính điểm</button>
</form>

@if (ViewBag.DiemTong != null)
{
    <p>Điểm tổng kết: @ViewBag.DiemTong</p>
}
