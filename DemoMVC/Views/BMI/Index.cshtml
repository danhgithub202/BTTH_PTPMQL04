@model PhatTrienPMQL2425K2.Models.BMIModel

<h2>Tính chỉ số BMI</h2>

<form method="post">
    <label>Chiều cao (m):</label>
    <input type="text" name="ChieuCao" required /><br/><br>

    <label>Cân nặng (kg):</label>
    <input type="text" name="CanNang" required /><br/>

    <button type="submit">Tính BMI</button>
</form>

@if (ViewBag.BMI != null)
{
    <p>BMI của bạn: @ViewBag.BMI</p>
    <p>Phân loại: @ViewBag.KetQua</p>
}
