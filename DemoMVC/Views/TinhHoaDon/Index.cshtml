@model DemoMVC.Models.TinhHoaDonModel

<h2>Tính tiền hóa đơn</h2>

<form method="post">
    <label>Số lượng:</label>
    <input type="number" name="SoLuong" required /><br/>

    <label>Đơn giá:</label>
    <input type="text" name="DonGia" required /><br/>

    <button type="submit">Tính tiền</button>
</form>

@if (ViewBag.TongTien != null)
{
    <p>Tổng tiền: @ViewBag.TongTien VND</p>
}
